# Sakura AI — Production Reverse Proxy & TLS Configuration Example (Nginx)
#
# Network Boundary Contract:
# - Publicly reachable: ONLY Nginx on 80 (HTTP->HTTPS redirect) and 443 (TLS).
# - Loopback / Private VPC only: frontend (127.0.0.1:3000), backend-api (127.0.0.1:8000).
# - Internal Docker network ONLY (NEVER exposed on host or public interface):
#   postgres (5432), redis (6379), sandbox-executor (9000).
#
# Ensure TRUSTED_PROXY_CIDRS on backend-api includes this reverse proxy's source IP/CIDR.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream sakura_frontend {
    server 127.0.0.1:3000;
    keepalive 32;
}

upstream sakura_backend {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN_HERE;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name YOUR_DOMAIN_HERE;

    # TLS configuration (replace with your certificate paths, e.g. certbot / ACM / Vault PKI)
    ssl_certificate     /etc/ssl/certs/sakura-fullchain.pem;
    ssl_certificate_key /etc/ssl/private/sakura-privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:SakuraSSL:10m;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 50m;

    # 1. WebSocket endpoint (ticket-authenticated; requires HTTP/1.1 Upgrade)
    location = /api/v1/ws {
        proxy_pass http://sakura_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # 2. Server-Sent Events (SSE) streaming endpoints — MUST disable proxy buffering
    location ~ ^/api/v1/(chat/stream|coding/(workspaces/[^/]+/)?tasks/[^/]+/events/stream)$ {
        proxy_pass http://sakura_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        add_header X-Accel-Buffering no;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # 3. Standard Backend API & Readiness Probes
    location /api/ {
        proxy_pass http://sakura_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location = /health {
        proxy_pass http://sakura_backend/health;
    }

    location = /readiness {
        # Restrict readiness probes to internal monitors / VPC CIDRs in production
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        proxy_pass http://sakura_backend/readiness;
    }

    # 4. Next.js Frontend
    location / {
        proxy_pass http://sakura_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
