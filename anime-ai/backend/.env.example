# Sakura AI — Environment Configuration Example
# Copy to .env and configure values before starting in production

# Environment & Security
ENVIRONMENT=development
JWT_SECRET=sakura_dev_secret_local_only_1234567890
INTEGRATION_ENCRYPTION_KEY=sakura_dev_integration_key_local_only_1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Databases
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/anime_ai
REDIS_URL=redis://localhost:6379/0

# Production Sandbox Executor Service
SAKURA_SANDBOX_RUNTIME=docker
SAKURA_SANDBOX_IMAGE=sakura-sandbox:latest
SAKURA_SANDBOX_EXECUTOR_URL=http://sandbox-executor:9000
SAKURA_SANDBOX_SERVICE_TOKEN=sakura_dev_sandbox_token_secret_12345

# LLM Providers
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Web Search
TAVILY_API_KEY=

# GitHub Integration (OAuth optional; PAT input via console)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
