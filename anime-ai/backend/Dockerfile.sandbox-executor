FROM docker:27-cli AS docker-cli

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Dedicated sandbox executor Dockerfile: uses modern static Docker CLI (>= API 1.44)
# instead of Debian's legacy docker.io client (API 1.41, rejected by Docker Engine >= 29)
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
RUN mkdir -p /workspaces && chown 1001:1001 /workspaces && chmod 770 /workspaces

EXPOSE 9000

CMD ["uvicorn", "coding.sandbox_service:app", "--host", "0.0.0.0", "--port", "9000"]
