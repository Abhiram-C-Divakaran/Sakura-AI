# ==============================================================================
# SAKURA AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment ('development', 'staging', 'production')
ENVIRONMENT=development

# Database & Caching
# SQLite local: sqlite:///./anime_ai.db
# PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/anime_ai
DATABASE_URL=sqlite:///./anime_ai.db
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
# CRITICAL: In production, generate a secure random key (e.g. `openssl rand -hex 32`).
# The application will refuse to start in production if the default placeholder is detected.
JWT_SECRET=sakura_dev_secret_change_for_prod_123456789
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Providers (Configure at least one)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Frontier Model Routing
SAKURA_MODEL_FAST=llama-3.1-8b-instant
SAKURA_MODEL_CODE=qwen/qwen3.8-27b
SAKURA_MODEL_REASONING=deepseek-r1-distill-llama-70b

# Reliability & Mock Control
# When set to false, failures raise explicit HTTP 503/502 errors instead of generating fake mock responses.
SAKURA_ALLOW_MOCKS=false

# Media & Image Generation (Optional)
STABILITY_API_KEY=
REPLICATE_API_TOKEN=

# RAG & Web Search (Optional)
TAVILY_API_KEY=
COHERE_API_KEY=
